{
  "name": "dsh-plugin-marketplace",
  "version": "0.5.0",
  "description": "Discover, install, update and uninstall plugins in the active DSH Desktop or Web profile.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./management": "./management.js",
    "./runtime": "./runtime.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0",
      "dshReleases": {
        "0.1.5-rc.2": "incompatible",
        "0.1.5-rc.3": "incompatible",
        "0.1.6-alpha.1": "unknown",
        "0.1.6-alpha.2": "unknown",
        "0.1.7-alpha.1": "unknown",
        "0.1.7-alpha.2": "unknown",
        "0.1.7-rc.1": "incompatible",
        "0.1.7-rc.2": "incompatible",
        "0.2.0-rc.2": "compatible"
      },
      "node": ">=20.18",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/settings-write-verify.test.mjs tests/runtime.test.mjs && node --test tests/plugin-page.test.mjs && node --test tests/locale.test.mjs && node --test tests/management.test.mjs"
  },
  "files": [
    "locale",
    "index.js",
    "runtime.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "vendor",
    "management.js",
    "VERIFICATION.md"
  ],
  "homepage": "https://github.com/Scorp1o117/dsh-plugin-marketplace",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "marketplace",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scorp1o117/dsh-plugin-marketplace.git"
  },
  "bugs": {
    "url": "https://github.com/Scorp1o117/dsh-plugin-marketplace/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.3.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2"
  }
}
