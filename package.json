{
    "name": "dsh-plugin-marketplace",
    "version": "0.4.0",
    "description": "DeepSeek Harness Web UI 内置插件市场：在设置页直接浏览 github.com/topics/dsh-plugin，支持搜索、按 Star 排序、查看安装方式。",
    "type": "module",
    "main": "index.js",
    "exports": {
        ".": "./index.js",
        "./client": "./client.js",
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web"
        },
        "compatibility": {
            "dsh": ">=0.2.0-rc.2 <0.3.0",
            "dshReleases": {
                "0.1.5-rc.2": "incompatible",
                "0.1.5-rc.3": "incompatible",
                "0.1.6-alpha.1": "unknown",
                "0.1.6-alpha.2": "unknown",
                "0.1.7-alpha.1": "unknown",
                "0.1.7-alpha.2": "unknown",
                "0.1.7-rc.1": "incompatible",
                "0.1.7-rc.2": "incompatible",
                "0.2.0-rc.2": "compatible"
            },
            "node": ">=20.18",
            "profiles": [
                "web",
                "desktop"
            ]
        }
    },
    "scripts": {
        "test": "node --test tests/settings-write-verify.test.mjs && node --test tests/plugin-page.test.mjs"
    },
    "files": [
        "index.js",
        "client.js",
        "cordis.patch.yml",
        "README.md",
        "README.zh.md",
        "LICENSE",
        "vendor"
    ],
    "homepage": "https://github.com/Scorp1o117/dsh-plugin-marketplace",
    "keywords": [
        "dsh",
        "dsh-plugin",
        "deepseek-harness",
        "marketplace",
        "web-ui"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=20.18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Scorp1o117/dsh-plugin-marketplace.git"
    },
    "bugs": {
        "url": "https://github.com/Scorp1o117/dsh-plugin-marketplace/issues"
    },
    "peerDependencies": {
        "react": "^18.2.0",
        "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.3.0",
        "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0"
    },
    "dependencies": {
        "@deepseek-ai/schemastery": "^3.18.4"
    }
}
